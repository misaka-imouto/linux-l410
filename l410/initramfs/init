#!/bin/busybox sh
# initramfs of the L410 kernel (l410/build.sh packs it with a static busybox).
#   l410.mode=probe   dump diagnostics to the kernel log (-> pstore console) and reboot
#   l410.mode=root    (default) mount root= and switch_root; on failure dump + reboot
#   l410.hold=<sec>   seconds to wait before rebooting after a dump (default 20)
/bin/busybox --install -s /bin
export PATH=/bin
mkdir -p /proc /sys /dev /run /newroot /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null

kmsg() { echo "L410INIT: $*" > /dev/kmsg; }

mode=root hold=20 root=""
for a in $(cat /proc/cmdline); do
	case $a in
	l410.mode=*) mode=${a#l410.mode=} ;;
	l410.hold=*) hold=${a#l410.hold=} ;;
	root=*) root=${a#root=} ;;
	esac
done
kmsg "start mode=$mode root=$root kernel=$(uname -r)"

dumpfile() { # $1 title, $2 file
	[ -r "$2" ] || return
	kmsg "----- $1"
	while IFS= read -r line; do kmsg "$line"; done < "$2"
}

dump() {
	kmsg "===== diagnostics"
	cat /proc/cpuinfo | grep -E "^processor|CPU part|CPU implementer" | tr '\n' ' ' > /tmp/cpus; echo >> /tmp/cpus
	dumpfile cpus /tmp/cpus
	dumpfile meminfo-head /proc/meminfo
	dumpfile interrupts /proc/interrupts
	dumpfile deferred /sys/kernel/debug/devices_deferred
	ls /sys/bus/platform/drivers > /tmp/drv 2>&1; dumpfile platform-drivers /tmp/drv
	for d in /sys/bus/platform/devices/*; do [ -e "$d/driver" ] && echo "$(basename $d) -> $(basename $(readlink $d/driver))"; done > /tmp/bound 2>&1
	dumpfile bound /tmp/bound
	ls -l /sys/class/block/ > /tmp/blk 2>&1; dumpfile block /tmp/blk
	ls /sys/class/net > /tmp/net 2>&1; dumpfile net /tmp/net
	ls /sys/bus/usb/devices > /tmp/usb 2>&1; dumpfile usb /tmp/usb
	kmsg "===== PUZZLE DIAGNOSTICS BEGIN ====="
	kmsg ">>> [PUZZLE 0] Suspend-to-idle & Wakeup"
	cat /sys/power/mem_sleep 2>/dev/null | while IFS= read -r line; do kmsg "P0 mem_sleep: $line"; done
	for w in /sys/class/wakeup/*; do
		[ -e "$w/name" ] && kmsg "P0 wakeup: $(cat $w/name 2>/dev/null)"
	done

	kmsg ">>> [PUZZLE 1] VCodec V500 Hardware Video Encoder (hisi-venc)"
	ls -l /sys/class/video4linux 2>/dev/null | while IFS= read -r line; do kmsg "P1 v4l2: $line"; done
	for v in /sys/class/video4linux/*; do
		[ -e "$v/name" ] && kmsg "P1 device: $(basename $v) -> $(cat $v/name 2>/dev/null)"
	done

	kmsg ">>> [PUZZLE 2] External Display (DP/HDMI)"
	ls -l /sys/class/drm 2>/dev/null | while IFS= read -r line; do kmsg "P2 drm: $line"; done
	for c in /sys/class/drm/*; do
		[ -e "$c/status" ] && kmsg "P2 connector: $(basename $c) status=$(cat $c/status 2>/dev/null) enabled=$(cat $c/enabled 2>/dev/null)"
	done

	kmsg ">>> [PUZZLE 3] Panfrost GPU (Mali-G76)"
	ls -l /sys/class/drm/card* 2>/dev/null | while IFS= read -r line; do kmsg "P3 card: $line"; done
	grep -i "panfrost" /proc/interrupts 2>/dev/null | while IFS= read -r line; do kmsg "P3 irq: $line"; done

	kmsg ">>> [PUZZLE 4] iTrustee TEE & Fingerprint"
	ls -l /dev/tc_ns_client /dev/fingerprint 2>/dev/null | while IFS= read -r line; do kmsg "P4 dev: $line"; done
	ls -l /sys/class/misc/fingerprint* 2>/dev/null | while IFS= read -r line; do kmsg "P4 misc: $line"; done
	kmsg "===== PUZZLE DIAGNOSTICS END ====="

	[ -x /l410-extra.sh ] && /l410-extra.sh 2>&1 | while IFS= read -r line; do kmsg "extra: $line"; done
	kmsg "===== end diagnostics"
}

bye() {
	kmsg "rebooting in $hold s"
	sleep "$hold"
	sync
	reboot -f
}

if [ "$mode" = probe ]; then
	sleep 2
	dev=""
	case $root in
	UUID=* | PARTUUID=* | LABEL=*) dev=$(findfs "$root" 2>/dev/null) ;;
	/dev/*) [ -b "$root" ] && dev=$root ;;
	esac
	if [ -n "$dev" ] && mount -o ro "$dev" /newroot 2>/dev/null; then
		kmsg "mounted root $dev to /newroot (ro) for modules"
		if [ -d "/newroot/lib/modules/$(uname -r)" ]; then
			mkdir -p /lib
			ln -sf "/newroot/lib/modules" /lib/modules
			kmsg "linked /lib/modules to /newroot/lib/modules"
			kmsg "loading hisi-venc..."
			modprobe hisi-venc 2>&1 | while IFS= read -r line; do kmsg "modprobe hisi-venc: $line"; done
			kmsg "loading huawei_fingerprint..."
			modprobe huawei_fingerprint 2>&1 | while IFS= read -r line; do kmsg "modprobe huawei_fingerprint: $line"; done
			kmsg "loading tzdriver..."
			modprobe tzdriver 2>&1 | while IFS= read -r line; do kmsg "modprobe tzdriver: $line"; done
		fi
	fi
	sleep 3
	dump
	bye
fi

# mode=root
dev=""
i=0
while [ $i -lt 60 ]; do
	case $root in
	UUID=* | PARTUUID=* | LABEL=*) dev=$(findfs "$root" 2>/dev/null) ;;
	/dev/*) [ -b "$root" ] && dev=$root ;;
	esac
	[ -n "$dev" ] && break
	sleep 1
	i=$((i + 1))
done
if [ -z "$dev" ]; then
	kmsg "root $root not found after 60 s"
	dump
	bye
fi
kmsg "root device $dev"
if ! mount -o ro "$dev" /newroot; then
	kmsg "mount $dev failed"
	dump
	bye
fi
umount /sys/kernel/debug 2>/dev/null
mount --move /dev /newroot/dev 2>/dev/null
umount /sys /proc 2>/dev/null
kmsg "switch_root"
exec switch_root /newroot /sbin/init
